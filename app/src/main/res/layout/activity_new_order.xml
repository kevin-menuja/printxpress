<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background">
    <LinearLayout android:id="@+id/header" android:layout_width="match_parent" android:layout_height="142dp" android:background="@drawable/order_header_gradient" android:gravity="center_vertical" android:orientation="vertical" android:paddingStart="18dp" android:paddingTop="10dp" android:paddingEnd="18dp" app:layout_constraintTop_toTopOf="parent">
